{
    "$schema": "https://opencode.ai/config.json",
    "theme": "opencode",
    "instructions": [
        ".ai/**"
    ],

    // V2 native permission rules. Ordered: LAST matching rule wins.
    // Docs: https://opencode.ai/v2/docs/permissions
    // Note: OpenCode's built-in base policy allows everything, so the first
    // rule below re-establishes "ask before running shell commands".
    "permissions": [
        // --- default: prompt for every shell command ---
        { "action": "shell", "resource": "*", "effect": "ask" },

        // --- explicit prompts (repo-controlled code execution / state mutation) ---
        { "action": "shell", "resource": "pwsh *", "effect": "ask" },
        { "action": "shell", "resource": "powershell *", "effect": "ask" },
        { "action": "shell", "resource": "dotnet run *", "effect": "ask" },
        { "action": "shell", "resource": "dotnet watch *", "effect": "ask" },
        { "action": "shell", "resource": "dotnet ef *", "effect": "ask" },
        { "action": "shell", "resource": "dotnet publish *", "effect": "ask" },
        { "action": "shell", "resource": "dotnet pack *", "effect": "ask" },
        { "action": "shell", "resource": "dotnet new *", "effect": "ask" },
        { "action": "shell", "resource": "dotnet sln add *", "effect": "ask" },
        { "action": "shell", "resource": "dotnet nuget push *", "effect": "ask" },
        { "action": "shell", "resource": "git push *", "effect": "ask" },
        { "action": "shell", "resource": "git commit *", "effect": "ask" },

        // --- .NET inner loop: no prompt ---
        { "action": "shell", "resource": "dotnet restore *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet build *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet test *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet format *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet list *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet sln list *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet nuget list source *", "effect": "allow" },
        { "action": "shell", "resource": "dotnet --info", "effect": "allow" },
        { "action": "shell", "resource": "dotnet --version", "effect": "allow" },
        { "action": "shell", "resource": "dotnet --list-sdks", "effect": "allow" },
        { "action": "shell", "resource": "dotnet --list-runtimes", "effect": "allow" },

        // --- package installs: no prompt ---
        { "action": "shell", "resource": "dotnet add package *", "effect": "allow" },
        { "action": "shell", "resource": "npm install *", "effect": "allow" },
        { "action": "shell", "resource": "npm ci *", "effect": "allow" },
        { "action": "shell", "resource": "npm i *", "effect": "allow" },
        { "action": "shell", "resource": "npm add *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm install *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm i *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm add *", "effect": "allow" },
        { "action": "shell", "resource": "yarn install *", "effect": "allow" },
        { "action": "shell", "resource": "yarn add *", "effect": "allow" },

        // --- search / inspect: no prompt ---
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "fd *", "effect": "allow" },
        { "action": "shell", "resource": "fdfind *", "effect": "allow" },
        { "action": "shell", "resource": "findstr *", "effect": "allow" },
        { "action": "shell", "resource": "Select-String *", "effect": "allow" },
        { "action": "shell", "resource": "git grep *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "dir *", "effect": "allow" },
        { "action": "shell", "resource": "Get-ChildItem *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "Get-Content *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "wc *", "effect": "allow" },
        { "action": "shell", "resource": "tree *", "effect": "allow" },
        { "action": "shell", "resource": "file *", "effect": "allow" },
        { "action": "shell", "resource": "stat *", "effect": "allow" },
        { "action": "shell", "resource": "where *", "effect": "allow" },
        { "action": "shell", "resource": "Get-Command *", "effect": "allow" },
        { "action": "shell", "resource": "Get-Location *", "effect": "allow" },
        { "action": "shell", "resource": "Test-Path *", "effect": "allow" },

        // --- read-only git: no prompt ---
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "git blame *", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
        { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
        { "action": "shell", "resource": "git describe *", "effect": "allow" },
        { "action": "shell", "resource": "git shortlog *", "effect": "allow" },
        { "action": "shell", "resource": "git branch", "effect": "allow" },
        { "action": "shell", "resource": "git branch --list *", "effect": "allow" },
        { "action": "shell", "resource": "git remote -v", "effect": "allow" },
        { "action": "shell", "resource": "git stash list *", "effect": "allow" },
        { "action": "shell", "resource": "git tag --list *", "effect": "allow" },
        { "action": "shell", "resource": "git config --get *", "effect": "allow" },
        { "action": "shell", "resource": "git config --list *", "effect": "allow" },
        { "action": "shell", "resource": "git worktree list *", "effect": "allow" }
    ],

    // Hard denies. Policies never prompt and cannot be lifted by an
    // "Allow always" approval. Docs: https://opencode.ai/v2/docs/policies
    // The first three close the code-execution flags of the auto-allowed
    // rg/fd rules: `rg --pre <cmd>` and `fd -x/--exec <cmd>` run commands.
    "policies": [
        { "action": "tool.use", "resource": "shell:*--pre*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:* --exec*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:* -x *", "effect": "deny" },

        // Add more as needed, e.g.:
        // { "action": "tool.use", "resource": "shell:*--ext-diff*", "effect": "deny" },
        // { "action": "tool.use", "resource": "shell:git push --force *", "effect": "deny" },
        // { "action": "tool.use", "resource": "shell:rm -rf *", "effect": "deny" },
        // { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" }
    ]
}
